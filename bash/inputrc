# Readline: how the command line edits and completes. bash/rc loads it; so
# does every other readline program, through INPUTRC (bash/profile).

$include /etc/inputrc

# ── Completion ──────────────────────────────────────────────────────
# Tab lists the choices at once and completes what they share; Tab again
# steps through them, Shift+Tab back.
set show-all-if-ambiguous on
set menu-complete-display-prefix on
TAB: menu-complete
"\e[Z": menu-complete-backward
# Case and - versus _ do not matter.
set completion-ignore-case on
set completion-map-case on
# Choices coloured as `ls` colours them, the part already typed set apart,
# and a / after directories, linked ones included.
set colored-stats on
set colored-completion-prefix on
set mark-symlinked-directories on
set visible-stats on
# Completing in the middle of a word does not repeat what follows.
set skip-completed-text on
# One page of choices without asking; past that, ask.
set completion-query-items 200
set page-completions off

# ── Editing ─────────────────────────────────────────────────────────
# No bell, no ^C echoed onto the line.
set bell-style none
set echo-control-characters off
# Pasted text is inserted as text, not run line by line.
set enable-bracketed-paste on
# Up and Down search the history for what is already typed.
"\e[A": history-search-backward
"\e[B": history-search-forward
# Ctrl+Left/Right move by word; Ctrl+Backspace and Ctrl+Delete delete one.
"\e[1;5D": backward-word
"\e[1;5C": forward-word
"\C-h": backward-kill-word
"\e[3;5~": kill-word
