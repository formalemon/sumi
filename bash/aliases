# Shorthands.

# ── Looking around ──────────────────────────────────────────────────
# Directories first, numbers in order (2 before 10), names clickable in
# Alacritty, and dates the way the bar writes them.
alias ls='ls --color=auto --group-directories-first --hyperlink=auto -v'
alias ll="ls -lh --time-style='+%-d %b %H:%M'"
alias la='ll -A'
alias lt='ll -tr'                   # newest last
alias grep='grep --color=auto'
alias diff='diff --color=auto'
alias ip='ip -color=auto'
alias ..='cd ..'
alias ...='cd ../..'
alias -- -='cd -'

# ── Safer, friendlier defaults ──────────────────────────────────────
alias cp='cp -iv'
alias mv='mv -iv'
alias rm='rm -I'                    # asks before removing more than three
alias mkdir='mkdir -pv'
alias df='df -h'
alias du='du -h'
alias free='free -h'

# ── Editing ─────────────────────────────────────────────────────────
alias v='nvim'
alias vim='nvim'

# ── Git ─────────────────────────────────────────────────────────────
alias g='git'
alias gs='git status -sb'
alias ga='git add'
alias gc='git commit'
alias gd='git diff'
alias gds='git diff --staged'
alias gl='git log --oneline --graph --decorate -20'
alias gp='git push'
alias gpl='git pull --rebase'
alias gco='git checkout'

# ── Arch ────────────────────────────────────────────────────────────
alias update='sudo pacman -Syu'
alias orphans='pacman -Qdtq'

# ── enso ────────────────────────────────────────────────────────────
alias theme='enso-ctl theme'

# ── Small tools ─────────────────────────────────────────────────────
alias path='echo "$PATH" | tr ":" "\n"'
alias reload='. ~/.bashrc'
# A clean screen, the prompt at its very top.
alias clear='__prompt_fresh=1; command clear'
# Make a directory and step into it.
mkcd() { mkdir -p -- "$1" && cd -- "$1"; }
