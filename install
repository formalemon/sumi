#!/usr/bin/env bash
# sumi — put these dotfiles in place. Safe to run again: what is already
# right is left alone, and nothing of yours is overwritten.
#
#   ./install          link the configs, make the directories they expect,
#                      fetch the cursor theme and the fonts — then ask which
#                      enso tools you want, if any (all, by default)
#   ./install --enso             all the enso tools, without asking
#   ./install --enso=bar,files   just these
#   ./install --no-enso          none: the dotfiles alone
#   ./install --enso-dev         the enso tools built from ~/dev/enso (or
#                                $ENSO) rather than its release, for working
#                                on enso; --enso-release goes back
#
# The dotfiles don't need enso. What each enso tool adds — to niri, to GTK,
# its config — is put in place only for the tools picked. The tools come from
# enso's release, pinned below like the fonts; --enso-dev is remembered.

set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
config=${XDG_CONFIG_HOME:-$HOME/.config}
state=${XDG_STATE_HOME:-$HOME/.local/state}
data=${XDG_DATA_HOME:-$HOME/.local/share}

# What comes from its authors' own releases rather than a package: the
# cursor, Bibata Modern Ice, and the fonts, Google Sans Flex (the interface)
# and Google Sans Code (the terminal). Each is pinned and checked, so a run
# today and a run in a year fetch the same thing. To move to a newer
# release, change its two lines and run again.
bibata_release=v2.0.7
bibata_sha256=a68cae60c4dc706350e194ebc91c5fe48bc7bc9d59e119555834a2a7ee5078ef
flex_release=v5.000
flex_sha256=c20b00878dd801d1bfc06d771732447940c7255bf94cf538ce0102c7fb06fa85
code_release=v7.001
code_sha256=eebba2a438882396e8530cad6d6cb80182b0afb6e9e0ad07b7340359a53ba2e9
# Noto Color Emoji, for the emoji Google Sans doesn't draw: the font file
# itself, from the tagged release of its repository.
emoji_release=v2026-09-24-unicode18_0
emoji_sha256=15671215ab769fdc7162a045d56fd7d7e477c51b04e6b3c761d914d8fdd6cc44
# And enso, from its own releases (x86-64 Linux; nothing to build). Moving
# to a newer release is the same: change these two lines and run again.
enso_release=v0.7.2
enso_sha256=10edd4d500d5126b393ae04885384c7c978d34b8bd7e797f1383d8c89b2cb467

say()  { printf '  %-10s %s\n' "$1" "$2"; }

# link <file or directory here> <where it belongs>
link() {
    local target=$here/$1 dest=$2
    if [[ -L $dest && $(readlink -f "$dest") == "$(readlink -f "$target")" ]]; then
        say ok "$dest"
    elif [[ -e $dest || -L $dest ]]; then
        say SKIPPED "$dest exists and is not this repo's; move it away and run again"
    else
        mkdir -p "$(dirname "$dest")"
        ln -s "$target" "$dest"
        say linked "$dest"
    fi
}

# point <where it belongs> <what it points to>: a link to a file outside
# this repo, which may not exist yet (enso's, written once enso runs).
point() {
    local dest=$1 target=$2
    if [[ -L $dest && $(readlink "$dest") == "$target" ]]; then
        say ok "$dest"
    elif [[ -e $dest || -L $dest ]]; then
        say SKIPPED "$dest exists and is not this repo's; move it away and run again"
    else
        mkdir -p "$(dirname "$dest")"
        ln -s "$target" "$dest"
        say linked "$dest"
    fi
}

# palette <theme toml>: its variant and colours, one `role #rrggbb` a line,
# in order — enough to tell two themes apart, whatever else differs.
palette() {
    local line table=
    while IFS= read -r line; do
        if [[ $line =~ ^[[:space:]]*\[([^]]*)\] ]]; then
            table=${BASH_REMATCH[1]}
        elif [[ -z $table && $line =~ ^variant[[:space:]]*=[[:space:]]*\"([a-z]+)\" ]]; then
            echo "variant ${BASH_REMATCH[1]}"
        elif [[ $table == colors && $line =~ ^[[:space:]]*([a-z-]+)[[:space:]]*=[[:space:]]*\"(#[0-9a-fA-F]{6})\" ]]; then
            echo "${BASH_REMATCH[1]} ${BASH_REMATCH[2],,}"
        fi
    done <"$1" | sort
}

# import <stylesheet> <generated enso file>: make the stylesheet, which is
# yours to add to, bring in the colours enso writes.
import() {
    local sheet=$1 line="@import url(\"file://$state/enso/$2\");"
    if [[ -f $sheet ]] && grep -qF "enso/$2" "$sheet"; then
        say ok "$sheet"
    else
        mkdir -p "$(dirname "$sheet")"
        # An @import has to come before any rule.
        { printf '%s\n' "$line"; [[ -f $sheet ]] && cat "$sheet"; } > "$sheet.tmp"
        mv "$sheet.tmp" "$sheet"
        say imports "$sheet"
    fi
}

# fetch <dest> <release> <url> <sha256> [<top>]: put what a release archive
# holds at <dest>, unless that release is already there. The archive must
# hold only <top>/ when one is named, or only plain files when not; a lone
# font file (.ttf) is put there as it is. What is
# at <dest> but was put there some other way is left alone. Says `fetched`
# when it fetched, so the caller can tell.
fetched=0
fetch() {
    local dest=$1 release=$2 url=$3 sha256=$4 top=${5:-}
    local stamp=$dest/.sumi-release
    if [[ -d $dest && ! -f $stamp ]]; then
        say ok "$dest (not sumi's; left alone)"
        return
    elif [[ -f $stamp && $(<"$stamp") == "$release" ]]; then
        say ok "$dest"
        return
    fi
    local tmp
    tmp=$(mktemp -d)
    local archive=$tmp/${url##*/}
    if ! curl -fsSL --proto '=https' -o "$archive" "$url"; then
        rm -rf "$tmp"
        say FAILED "could not download ${url##*/}"
        return
    fi
    if ! printf '%s  %s\n' "$sha256" "$archive" | sha256sum --check --status; then
        rm -rf "$tmp"
        say FAILED "${url##*/} does not match its checksum; nothing installed"
        return
    fi
    # bsdtar (pacman's own libarchive) reads tarballs and zips alike.
    local strays
    if [[ $archive == *.ttf ]]; then
        strays=
    elif [[ -n $top ]]; then
        strays=$(bsdtar -tf "$archive" | grep -v "^$top/" || true)
    else
        strays=$(bsdtar -tf "$archive" | grep -E '/|^\.' || true)
    fi
    if [[ -n $strays ]]; then
        rm -rf "$tmp"
        say FAILED "${url##*/} holds more than it should; nothing installed"
        return
    fi
    mkdir -p "$tmp/out"
    if [[ $archive == *.ttf ]]; then
        mv "$archive" "$tmp/out/"
    else
        bsdtar -xf "$archive" -C "$tmp/out" --no-same-owner --no-same-permissions
    fi
    local unpacked=$tmp/out${top:+/$top}
    printf '%s\n' "$release" > "$unpacked/.sumi-release"
    mkdir -p "$(dirname "$dest")"
    rm -rf "$dest"
    mv "$unpacked" "$dest"
    rm -rf "$tmp"
    fetched=1
    say fetched "$dest ($release)"
}

echo "configs"
link niri       "$config/niri"
link alacritty  "$config/alacritty"
link nvim       "$config/nvim"
link fontconfig "$config/fontconfig"
link bash/profile "$HOME/.bash_profile"
link bash/rc      "$HOME/.bashrc"

echo "colours"
# The static colour files, from theme/rose-pine-moon.toml.
"$here/theme/render"

echo "directories"
# niri saves screenshots here and does not make the directory itself.
for dir in "$HOME/Pictures/Screenshots" "$state/bash" "$state/python" "$HOME/.local/bin"; do
    mkdir -p "$dir" && say ok "$dir"
done

echo "cursor and fonts"
fetch "$data/icons/Bibata-Modern-Ice" "$bibata_release" \
    "https://github.com/ful1e5/Bibata_Cursor/releases/download/$bibata_release/Bibata-Modern-Ice.tar.xz" \
    "$bibata_sha256" Bibata-Modern-Ice
fetch "$data/fonts/GoogleSansFlex" "$flex_release" \
    "https://github.com/googlefonts/googlesans-flex/releases/download/$flex_release/GoogleSansFlex-$flex_release.zip" \
    "$flex_sha256"
fetch "$data/fonts/GoogleSansCode" "$code_release" \
    "https://github.com/googlefonts/googlesans-code/releases/download/$code_release/GoogleSansCode-$code_release.zip" \
    "$code_sha256"
fetch "$data/fonts/NotoColorEmoji" "$emoji_release" \
    "https://github.com/googlefonts/noto-emoji/raw/$emoji_release/2D/fonts/NotoColorEmoji.ttf" \
    "$emoji_sha256"
# New fonts are only seen once fontconfig's cache knows them.
((fetched)) && fc-cache "$data/fonts" && say cached "$data/fonts"

echo "firefox"
# Every profile's interface, and the setting that lets it be styled.
found=0
for profile in "$config"/mozilla/firefox/*/ "$HOME"/.mozilla/firefox/*/; do
    [[ -f ${profile}prefs.js || -f ${profile}times.json ]] || continue
    found=1
    link firefox/userChrome.css "${profile}chrome/userChrome.css"
    link firefox/rose-pine-moon.css "${profile}chrome/rose-pine-moon.css"
    # Where enso writes Firefox's colours, if it ever does: userChrome.css
    # imports it by this name, so no home directory is written in it.
    point "${profile}chrome/enso.css" "$state/enso/firefox.css"
    link firefox/user.js        "${profile}user.js"
done
((found)) || say - "no Firefox profile yet; run again once Firefox has started"

# ── enso ─────────────────────────────────────────────────────────────
# Which enso tools, if any. Each picked tool gets its binary on PATH, its
# part of the niri config (niri/enso/<tool>.kdl), and whatever else it needs;
# a tool not picked leaves no trace.

tools=(bar launch ctl notify wall power lock files view listen auth keyring play clip dusk greet)
declare -A about=(
    [bar]="status bar"
    [launch]="launcher for apps and files"
    [ctl]="control center, and one theme for everything"
    [notify]="notifications"
    [wall]="wallpaper"
    [power]="power menu"
    [lock]="lock screen"
    [files]="file manager, and every app's file chooser"
    [view]="pictures and videos open in it"
    [listen]="sound files open in it, one after another"
    [auth]="asks for your password, and Bluetooth codes"
    [keyring]="keeps passwords and tokens, opened by your login"
    [play]="what's playing, under the clock, and the media keys"
    [clip]="clipboard history (Mod+Ctrl+V)"
    [dusk]="night light: warm screens from sunset to sunrise"
    [greet]="login screen (greetd; root puts it in place)"
)
remembered=$state/sumi/enso-tools
previous=" $(tr '\n' ' ' 2>/dev/null <"$remembered" || true) "
asking=0
[[ -t 0 && -r /dev/tty ]] && asking=1

# Where the tools come from: the release (the default), or a checkout built
# here. The last choice holds until another is made.
remembered_source=$state/sumi/enso-source
source=
choice=
for arg in "$@"; do
    case $arg in
        --enso) choice=all ;;
        --no-enso) choice=none ;;
        --enso=*) choice=${arg#--enso=} ;;
        --enso-dev) source=dev ;;
        --enso-release) source=release ;;
        *) echo "install: unknown option $arg" >&2; exit 2 ;;
    esac
done

# ask <question> <default y|n>: yes or no, from the terminal.
ask() {
    local answer hint="[Y/n]"
    [[ $2 == n ]] && hint="[y/N]"
    read -rp "  $1 $hint " answer </dev/tty || answer=
    answer=${answer,,}
    [[ ${answer:-$2} == y* ]]
}

echo "enso"
if [[ -z $choice ]] && ((asking)); then
    echo "  The enso desktop: a bar, a launcher, a control center, notifications,"
    echo "  a wallpaper, power menu, lock screen, a file manager, a viewer for"
    echo "  pictures and videos, a player for sound, a prompt for passwords and"
    echo "  pairing codes, a keyring, what's playing, clipboard history, a night"
    echo "  light, and a login screen."
    read -rp "  Install them? [Y]es, all · [n]o · [s]ome " answer </dev/tty || answer=
    case ${answer,,} in
        '' | y | yes) choice=all ;;
        n | no) choice=none ;;
        *) choice=some ;;
    esac
fi
picked=()
case ${choice:-all} in
    all) picked=("${tools[@]}") ;;
    none) ;;
    some)
        for tool in "${tools[@]}"; do
            # The last answer is the default; the first time, yes.
            default=y
            [[ -f $remembered && $previous != *" $tool "* ]] && default=n
            ask "$(printf 'enso-%-7s %-46s' "$tool" "${about[$tool]}")" "$default" && picked+=("$tool")
        done
        ;;
    *)
        IFS=, read -ra picked <<<"$choice"
        for tool in "${picked[@]}"; do
            [[ -v about[$tool] ]] || { echo "install: no enso tool called $tool" >&2; exit 2; }
        done
        ;;
esac
has() { [[ " ${picked[*]} " == *" $1 "* ]]; }
mkdir -p "$state/sumi"
printf '%s\n' "${picked[@]}" >"$remembered"
source=${source:-$(cat "$remembered_source" 2>/dev/null || echo release)}
printf '%s\n' "$source" >"$remembered_source"

enso=${ENSO:-$HOME/dev/enso}
released=$data/enso/release
bin=$HOME/.local/bin
# ours <link>: whether a link in ~/.local/bin is one this script made.
ours() {
    [[ -L $1 && ( $(readlink "$1") == "$enso/target/"* || $(readlink "$1") == "$released/"* ) ]]
}
# Tools no longer wanted: their links go (only ours).
for tool in "${tools[@]}"; do
    has "$tool" && continue
    link=$bin/enso-$tool
    ours "$link" || continue
    # The file chooser goes back to what it was before taking it away.
    if [[ $tool == files ]]; then
        "$link" portal disable | sed 's/^/  /' || true
    fi
    # Nor is it the keyring anymore (what's in it stays, sealed), nor what
    # opens pictures, videos or sound.
    if [[ $tool == keyring || $tool == view || $tool == listen ]]; then
        "$link" disable | sed 's/^/  /' || true
    fi
    # The login screen is root's to take away: it says how.
    if [[ $tool == greet ]]; then
        "$link" disable | sed 's/^/  /' || true
    fi
    rm "$link"
    say removed "$link"
done

# place <dir>: link each picked tool from <dir>, over a link of ours but
# never over a program put there some other way.
place() {
    local tool link
    mkdir -p "$bin"
    for tool in "${picked[@]}"; do
        link=$bin/enso-$tool
        if [[ -e $link || -L $link ]] && ! ours "$link"; then
            say SKIPPED "$link exists and is not sumi's; move it away and run again"
        elif [[ ! -x $1/enso-$tool && $source == release ]]; then
            # A tool newer than the pinned release waits for the next one.
            say SKIPPED "enso-$tool is not in enso $enso_release yet (--enso-dev builds it)"
        elif [[ ! -x $1/enso-$tool ]]; then
            say FAILED "no enso-$tool in $1"
        else
            ln -sfn "$1/enso-$tool" "$link"
        fi
    done
}

if ((${#picked[@]})); then
    if [[ $source == dev ]]; then
        if [[ -f $enso/Cargo.toml ]]; then
            packages=()
            for tool in "${picked[@]}"; do packages+=(-p "enso-$tool"); done
            (cd "$enso" && cargo build --release "${packages[@]}")
            place "$enso/target/release"
            say built "${picked[*]} (from $enso)"
        else
            say SKIPPED "no enso checkout at $enso (set ENSO=…, or --enso-release)"
        fi
    else
        fetch "$released" "$enso_release" \
            "https://github.com/formalemon/enso/releases/download/$enso_release/enso-$enso_release-x86_64-linux.tar.gz" \
            "$enso_sha256" "enso-$enso_release-x86_64-linux"
        place "$released"
        say linked "${picked[*]} (enso $enso_release)"
    fi
    link enso "$config/enso"
fi

# niri: the picked tools' parts, which niri/config.kdl includes if present.
# Only for a tool that is really on PATH now: one that couldn't be had (not
# in the release yet, a failed build) leaves core/'s keys as they are.
niri_enso=$state/sumi/niri-enso.kdl
niri_enso_first=$state/sumi/niri-enso-first.kdl
if ((${#picked[@]})); then
    {
        echo "// Written by sumi's install: the enso tools picked, each adding to niri."
        for tool in "${picked[@]}"; do
            [[ -f $here/niri/enso/$tool.kdl && -x $bin/enso-$tool ]] || continue
            ours "$bin/enso-$tool" || continue
            echo "include \"~/.config/niri/enso/$tool.kdl\""
        done
    } >"$niri_enso"
    say ok "$niri_enso"
    # The few parts that must come before core/ (niri/enso/first/).
    {
        echo "// Written by sumi's install: enso parts niri must read before core/."
        for tool in "${picked[@]}"; do
            [[ -f $here/niri/enso/first/$tool.kdl && -x $bin/enso-$tool ]] || continue
            ours "$bin/enso-$tool" || continue
            echo "include \"~/.config/niri/enso/first/$tool.kdl\""
        done
    } >"$niri_enso_first"
else
    rm -f "$niri_enso" "$niri_enso_first"
fi

# The control center's theme reaches GTK 3 (file choosers, dialogs) and
# GTK 4 through these imports.
if has ctl; then
    import "$config/gtk-3.0/gtk.css" gtk-3.0.css
    import "$config/gtk-4.0/gtk.css" gtk-4.0.css
fi

# The file manager as every application's file chooser: its own set-up.
if has keyring && [[ -x $bin/enso-keyring ]]; then
    "$bin/enso-keyring" enable | sed 's/^/  /'
fi

# The login screen readies its files; putting them in place is root's, and
# it prints the lines for that. sumi runs nothing as root.
if has greet && [[ -x $bin/enso-greet ]]; then
    "$bin/enso-greet" enable | sed 's/^/  /'
fi

# What pictures and videos open in, and sound files (those nothing else
# was chosen for).
if has view && [[ -x $bin/enso-view ]]; then
    "$bin/enso-view" enable | sed 's/^/  /'
fi
if has listen && [[ -x $bin/enso-listen ]]; then
    "$bin/enso-listen" enable | sed 's/^/  /'
fi

if has files && [[ -x $bin/enso-files ]]; then
    if ((!asking)) || ask "Use enso-files as every app's file chooser?" y; then
        "$bin/enso-files" portal enable | sed 's/^/  /'
    fi
fi

# sumi's palette, which enso shows too. The same as enso's built-in theme
# of its name, there's nothing to do; different, it goes in as the theme
# `sumi`, and is chosen — so enso never puts its own look over this one.
if ((${#picked[@]})); then
    echo "palette"
    ours=$here/theme/rose-pine-moon.toml
    registered=$config/enso/themes/sumi.toml
    # enso's own rose-pine-moon, as `palette` gives it, from the enso-ctl
    # just installed — or, without it, from the checkout.
    theirs=
    if [[ -x $bin/enso-ctl ]]; then
        theirs=$("$bin/enso-ctl" theme show rose-pine-moon 2>/dev/null | {
            read -r first
            [[ $first =~ ,\ ([a-z]+)\)$ ]] && echo "variant ${BASH_REMATCH[1]}"
            while read -r role hex; do echo "$role ${hex,,}"; done
        } | sort)
    elif [[ -f $enso/crates/enso-core/themes/rose-pine-moon.toml ]]; then
        theirs=$(palette "$enso/crates/enso-core/themes/rose-pine-moon.toml")
    fi
    if [[ -z $theirs ]]; then
        say SKIPPED "no enso to compare the palette with"
    elif [[ $(palette "$ours") == "$theirs" ]]; then
        say ok "enso's rose-pine-moon is sumi's palette"
        if [[ -f $registered ]] && grep -q '^# Written by sumi' "$registered"; then
            rm "$registered"
            say removed "$registered (no longer different)"
            if has ctl && [[ $("$bin/enso-ctl" theme current 2>/dev/null) == sumi ]]; then
                "$bin/enso-ctl" theme set rose-pine-moon | sed 's/^/  /'
            fi
        fi
    else
        mkdir -p "$(dirname "$registered")"
        {
            echo "# Written by sumi's install from theme/rose-pine-moon.toml, which differs"
            echo "# from enso's own rose-pine-moon; change that, and run install again."
            sed -e '/^#/d' -e 's/^name = "\(.*\)"$/name = "\1 (sumi)"/' "$ours"
        } >"$registered.tmp"
        if [[ -f $registered ]] && cmp -s "$registered.tmp" "$registered"; then
            rm "$registered.tmp"
            say ok "$registered"
        else
            mv "$registered.tmp" "$registered"
            say wrote "$registered"
        fi
        if has ctl && [[ -x $bin/enso-ctl ]]; then
            if [[ $("$bin/enso-ctl" theme current 2>/dev/null) != sumi ]]; then
                "$bin/enso-ctl" theme set sumi | sed 's/^/  /'
            fi
        else
            say - "enso shows the theme \`sumi\` once it's chosen: theme = \"sumi\" in enso's config"
        fi
    fi
fi

# Write the theme everywhere, now that everything includes it.
if has ctl && [[ -x $bin/enso-ctl ]]; then
    echo "theme"
    "$bin/enso-ctl" theme apply | sed 's/^/  /'
fi
