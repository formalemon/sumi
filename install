#!/usr/bin/env bash
# sumi — put these dotfiles in place. Safe to run again: what is already
# right is left alone, and nothing of yours is overwritten.
#
#   ./install          link the configs, make the directories they expect,
#                      fetch the cursor theme and the fonts — then ask which
#                      enso tools you want, if any (all, by default)
#   ./install --enso             all the enso tools, without asking
#   ./install --enso=bar,files   just these
#   ./install --no-enso          none: the dotfiles alone
#
# The dotfiles don't need enso. What each enso tool adds — to niri, to GTK,
# its config — is put in place only for the tools picked; enso is built from
# ~/dev/enso (or $ENSO).

set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
config=${XDG_CONFIG_HOME:-$HOME/.config}
state=${XDG_STATE_HOME:-$HOME/.local/state}
data=${XDG_DATA_HOME:-$HOME/.local/share}

# What comes from its authors' own releases rather than a package: the
# cursor, Bibata Modern Ice, and the fonts, Google Sans Flex (the interface)
# and Google Sans Code (the terminal). Each is pinned and checked, so a run
# today and a run in a year fetch the same thing. To move to a newer
# release, change its two lines and run again.
bibata_release=v2.0.7
bibata_sha256=a68cae60c4dc706350e194ebc91c5fe48bc7bc9d59e119555834a2a7ee5078ef
flex_release=v5.000
flex_sha256=c20b00878dd801d1bfc06d771732447940c7255bf94cf538ce0102c7fb06fa85
code_release=v7.001
code_sha256=eebba2a438882396e8530cad6d6cb80182b0afb6e9e0ad07b7340359a53ba2e9

say()  { printf '  %-10s %s\n' "$1" "$2"; }

# link <file or directory here> <where it belongs>
link() {
    local target=$here/$1 dest=$2
    if [[ -L $dest && $(readlink -f "$dest") == "$(readlink -f "$target")" ]]; then
        say ok "$dest"
    elif [[ -e $dest || -L $dest ]]; then
        say SKIPPED "$dest exists and is not this repo's; move it away and run again"
    else
        mkdir -p "$(dirname "$dest")"
        ln -s "$target" "$dest"
        say linked "$dest"
    fi
}

# import <stylesheet> <generated enso file>: make the stylesheet, which is
# yours to add to, bring in the colours enso writes.
import() {
    local sheet=$1 line="@import url(\"file://$state/enso/$2\");"
    if [[ -f $sheet ]] && grep -qF "enso/$2" "$sheet"; then
        say ok "$sheet"
    else
        mkdir -p "$(dirname "$sheet")"
        # An @import has to come before any rule.
        { printf '%s\n' "$line"; [[ -f $sheet ]] && cat "$sheet"; } > "$sheet.tmp"
        mv "$sheet.tmp" "$sheet"
        say imports "$sheet"
    fi
}

# fetch <dest> <release> <url> <sha256> [<top>]: put what a release archive
# holds at <dest>, unless that release is already there. The archive must
# hold only <top>/ when one is named, or only plain files when not. What is
# at <dest> but was put there some other way is left alone. Says `fetched`
# when it fetched, so the caller can tell.
fetched=0
fetch() {
    local dest=$1 release=$2 url=$3 sha256=$4 top=${5:-}
    local stamp=$dest/.sumi-release
    if [[ -d $dest && ! -f $stamp ]]; then
        say ok "$dest (not sumi's; left alone)"
        return
    elif [[ -f $stamp && $(<"$stamp") == "$release" ]]; then
        say ok "$dest"
        return
    fi
    local tmp
    tmp=$(mktemp -d)
    local archive=$tmp/${url##*/}
    if ! curl -fsSL --proto '=https' -o "$archive" "$url"; then
        rm -rf "$tmp"
        say FAILED "could not download ${url##*/}"
        return
    fi
    if ! printf '%s  %s\n' "$sha256" "$archive" | sha256sum --check --status; then
        rm -rf "$tmp"
        say FAILED "${url##*/} does not match its checksum; nothing installed"
        return
    fi
    # bsdtar (pacman's own libarchive) reads tarballs and zips alike.
    local strays
    if [[ -n $top ]]; then
        strays=$(bsdtar -tf "$archive" | grep -v "^$top/" || true)
    else
        strays=$(bsdtar -tf "$archive" | grep -E '/|^\.' || true)
    fi
    if [[ -n $strays ]]; then
        rm -rf "$tmp"
        say FAILED "${url##*/} holds more than it should; nothing installed"
        return
    fi
    mkdir -p "$tmp/out"
    bsdtar -xf "$archive" -C "$tmp/out" --no-same-owner --no-same-permissions
    local unpacked=$tmp/out${top:+/$top}
    printf '%s\n' "$release" > "$unpacked/.sumi-release"
    mkdir -p "$(dirname "$dest")"
    rm -rf "$dest"
    mv "$unpacked" "$dest"
    rm -rf "$tmp"
    fetched=1
    say fetched "$dest ($release)"
}

echo "configs"
link niri       "$config/niri"
link alacritty  "$config/alacritty"
link nvim       "$config/nvim"
link fontconfig "$config/fontconfig"
link bash/profile "$HOME/.bash_profile"
link bash/rc      "$HOME/.bashrc"

echo "directories"
# niri saves screenshots here and does not make the directory itself.
for dir in "$HOME/Pictures/Screenshots" "$state/bash" "$state/python" "$HOME/.local/bin"; do
    mkdir -p "$dir" && say ok "$dir"
done

echo "cursor and fonts"
fetch "$data/icons/Bibata-Modern-Ice" "$bibata_release" \
    "https://github.com/ful1e5/Bibata_Cursor/releases/download/$bibata_release/Bibata-Modern-Ice.tar.xz" \
    "$bibata_sha256" Bibata-Modern-Ice
fetch "$data/fonts/GoogleSansFlex" "$flex_release" \
    "https://github.com/googlefonts/googlesans-flex/releases/download/$flex_release/GoogleSansFlex-$flex_release.zip" \
    "$flex_sha256"
fetch "$data/fonts/GoogleSansCode" "$code_release" \
    "https://github.com/googlefonts/googlesans-code/releases/download/$code_release/GoogleSansCode-$code_release.zip" \
    "$code_sha256"
# New fonts are only seen once fontconfig's cache knows them.
((fetched)) && fc-cache "$data/fonts" && say cached "$data/fonts"

echo "firefox"
# Every profile's interface, and the setting that lets it be styled.
found=0
for profile in "$config"/mozilla/firefox/*/ "$HOME"/.mozilla/firefox/*/; do
    [[ -f ${profile}prefs.js || -f ${profile}times.json ]] || continue
    found=1
    link firefox/userChrome.css "${profile}chrome/userChrome.css"
    link firefox/user.js        "${profile}user.js"
done
((found)) || say - "no Firefox profile yet; run again once Firefox has started"

# ── enso ─────────────────────────────────────────────────────────────
# Which enso tools, if any. Each picked tool gets its binary on PATH, its
# part of the niri config (niri/enso/<tool>.kdl), and whatever else it needs;
# a tool not picked leaves no trace.

tools=(bar launch ctl notify wall power lock files auth keyring)
declare -A about=(
    [bar]="status bar"
    [launch]="launcher for apps and files"
    [ctl]="control center, and one theme for everything"
    [notify]="notifications"
    [wall]="wallpaper"
    [power]="power menu"
    [lock]="lock screen"
    [files]="file manager, and every app's file chooser"
    [auth]="asks for your password, and Bluetooth codes"
    [keyring]="keeps passwords and tokens, opened by your login"
)
remembered=$state/sumi/enso-tools
previous=" $(tr '\n' ' ' 2>/dev/null <"$remembered" || true) "
asking=0
[[ -t 0 && -r /dev/tty ]] && asking=1

choice=
for arg in "$@"; do
    case $arg in
        --enso) choice=all ;;
        --no-enso) choice=none ;;
        --enso=*) choice=${arg#--enso=} ;;
        *) echo "install: unknown option $arg" >&2; exit 2 ;;
    esac
done

# ask <question> <default y|n>: yes or no, from the terminal.
ask() {
    local answer hint="[Y/n]"
    [[ $2 == n ]] && hint="[y/N]"
    read -rp "  $1 $hint " answer </dev/tty || answer=
    answer=${answer,,}
    [[ ${answer:-$2} == y* ]]
}

echo "enso"
if [[ -z $choice ]] && ((asking)); then
    echo "  The enso desktop: a bar, a launcher, a control center, notifications,"
    echo "  a wallpaper, power menu, lock screen, a file manager, a prompt for"
    echo "  passwords and pairing codes, and a keyring."
    read -rp "  Install them? [Y]es, all · [n]o · [s]ome " answer </dev/tty || answer=
    case ${answer,,} in
        '' | y | yes) choice=all ;;
        n | no) choice=none ;;
        *) choice=some ;;
    esac
fi
picked=()
case ${choice:-all} in
    all) picked=("${tools[@]}") ;;
    none) ;;
    some)
        for tool in "${tools[@]}"; do
            # The last answer is the default; the first time, yes.
            default=y
            [[ -f $remembered && $previous != *" $tool "* ]] && default=n
            ask "$(printf 'enso-%-7s %-46s' "$tool" "${about[$tool]}")" "$default" && picked+=("$tool")
        done
        ;;
    *)
        IFS=, read -ra picked <<<"$choice"
        for tool in "${picked[@]}"; do
            [[ -v about[$tool] ]] || { echo "install: no enso tool called $tool" >&2; exit 2; }
        done
        ;;
esac
has() { [[ " ${picked[*]} " == *" $1 "* ]]; }
mkdir -p "$state/sumi"
printf '%s\n' "${picked[@]}" >"$remembered"

enso=${ENSO:-$HOME/dev/enso}
bin=$HOME/.local/bin
# Tools no longer wanted: their links go (only ours, into the enso build).
for tool in "${tools[@]}"; do
    has "$tool" && continue
    link=$bin/enso-$tool
    [[ -L $link && $(readlink "$link") == "$enso/target/"* ]] || continue
    # The file chooser goes back to what it was before taking it away.
    if [[ $tool == files ]]; then
        "$link" portal disable | sed 's/^/  /' || true
    fi
    # Nor is it the keyring anymore (what's in it stays, sealed).
    if [[ $tool == keyring ]]; then
        "$link" disable | sed 's/^/  /' || true
    fi
    rm "$link"
    say removed "$link"
done

if ((${#picked[@]})); then
    if [[ -f $enso/Cargo.toml ]]; then
        packages=()
        for tool in "${picked[@]}"; do packages+=(-p "enso-$tool"); done
        (cd "$enso" && cargo build --release "${packages[@]}")
        for tool in "${picked[@]}"; do
            ln -sf "$enso/target/release/enso-$tool" "$bin/enso-$tool"
        done
        say built "${picked[*]}"
    else
        say SKIPPED "no enso checkout at $enso (set ENSO=…)"
    fi
    link enso "$config/enso"
fi

# niri: the picked tools' parts, which niri/config.kdl includes if present.
niri_enso=$state/sumi/niri-enso.kdl
if ((${#picked[@]})); then
    {
        echo "// Written by sumi's install: the enso tools picked, each adding to niri."
        for tool in "${picked[@]}"; do
            [[ -f $here/niri/enso/$tool.kdl ]] && echo "include \"~/.config/niri/enso/$tool.kdl\""
        done
    } >"$niri_enso"
    say ok "$niri_enso"
else
    rm -f "$niri_enso"
fi

# The control center's theme reaches GTK 3 (file choosers, dialogs) and
# GTK 4 through these imports.
if has ctl; then
    import "$config/gtk-3.0/gtk.css" gtk-3.0.css
    import "$config/gtk-4.0/gtk.css" gtk-4.0.css
fi

# The file manager as every application's file chooser: its own set-up.
if has keyring && [[ -x $bin/enso-keyring ]]; then
    "$bin/enso-keyring" enable | sed 's/^/  /'
fi

if has files && [[ -x $bin/enso-files ]]; then
    if ((!asking)) || ask "Use enso-files as every app's file chooser?" y; then
        "$bin/enso-files" portal enable | sed 's/^/  /'
    fi
fi

# Write the theme everywhere, now that everything includes it.
if has ctl && [[ -x $bin/enso-ctl ]]; then
    echo "theme"
    "$bin/enso-ctl" theme apply | sed 's/^/  /'
fi
