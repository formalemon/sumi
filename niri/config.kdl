// niri — entry point. Every concern lives in its own file; this one only
// says which, and in what order. Later files win where two set the same thing.
// https://niri-wm.github.io/niri/Configuration:-Introduction
//
// core/ is niri on its own: these dotfiles need nothing else.
// enso/ holds what each enso tool adds (what it starts, its keys, its
// rules), one file per tool. ./install writes the list of the tools you
// picked to ~/.local/state/sumi/niri-enso.kdl; without it, niri is core/.

// What an enso tool must say first: niri takes the first section it finds
// for a screen, so screens kept by the control center's Displays page come
// before core/outputs.kdl. ./install writes it; without enso it's absent.
include optional=true "~/.local/state/sumi/niri-enso-first.kdl"

include "core/outputs.kdl"   // monitors
include "core/input.kdl"     // keyboard, touchpad, mouse
include "core/layout.kdl"    // gaps, column widths, ring and shadow geometry
include "core/theme.kdl"     // colours
include "core/rules.kdl"     // window and layer rules
include "core/session.kdl"   // cursor, screenshots, overlays
include "core/binds.kdl"     // keys

// The enso tools picked at install, each adding to the above.
include optional=true "~/.local/state/sumi/niri-enso.kdl"
