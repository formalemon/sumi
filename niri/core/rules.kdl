// Window and layer rules.
// https://niri-wm.github.io/niri/Configuration:-Window-Rules

// ── Every window ────────────────────────────────────────────────────
// The same 12px corner enso's panels and toasts use. Clipping keeps a
// window's content from showing past the rounded corner.
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

// ── Applications ────────────────────────────────────────────────────

// Picture-in-picture floats.
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// Keep secrets out of recordings and screenshots.
