// Colours — Rosé Pine Moon. With enso-ctl installed, the active enso
// theme's colours are written over these (niri/enso/ctl.kdl), so niri
// follows theme switches by itself.
//
//   base  #232136   overlay        #393552   iris  #c4a7e7
//   love  #eb6f92   highlight-med  #44415a   foam  #9ccfd8

layout {
    // Behind everything: the desktop, until a wallpaper is drawn over it.
    background-color "#232136"            // base

    focus-ring {
        active-color   "#c4a7e7"          // iris
        inactive-color "#44415a"          // highlight-med
        urgent-color   "#eb6f92"          // love
    }

    border {
        active-color   "#c4a7e7"
        inactive-color "#44415a"
        urgent-color   "#eb6f92"
    }

    shadow {
        color "#00000066"
    }

    tab-indicator {
        active-color   "#c4a7e7"
        inactive-color "#44415a"
        urgent-color   "#eb6f92"
    }

    insert-hint {
        color "#c4a7e766"                 // iris, translucent
    }
}

overview {
    backdrop-color "#232136"              // base
}

recent-windows {
    highlight {
        active-color "#c4a7e7"
        urgent-color "#eb6f92"
        corner-radius 12
    }
}
