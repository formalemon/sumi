// The session around the windows: decorations, cursor, screenshots, overlays.
// https://niri-wm.github.io/niri/Configuration:-Miscellaneous

// No title bars: niri draws the ring and the rounded corners itself.
prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// The cursor's theme and size are niri's defaults here; enso-ctl, when
// installed, sets them (niri/enso/ctl.kdl).
cursor {
    hide-when-typing
}

// The key list is one press away (Mod+Shift+/), not shown at every login.
hotkey-overlay {
    skip-at-startup
}
