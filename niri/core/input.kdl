// Input devices.
// https://niri-wm.github.io/niri/Configuration:-Input

input {
    keyboard {
        xkb {
            // layout "us,ru"
            // options "grp:win_space_toggle,compose:ralt,ctrl:nocaps"
        }

        numlock
    }

    touchpad {
        tap
        // Ignore the touchpad while typing, and while the TrackPoint is
        // in use: a palm resting on the pad moves and clicks nothing.
        dwt
        dwtp
        natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
    }

    mouse {
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
    }

    trackpoint {
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
    }

    // warp-mouse-to-focus
    // focus-follows-mouse max-scroll-amount="0%"
}
