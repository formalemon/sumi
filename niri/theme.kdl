// Colours — Rosé Pine Moon, the palette enso uses by default.
// These are the colours before enso has had a say. `enso-ctl theme set`
// writes the active theme's over them (see the include in config.kdl), so
// niri follows theme switches by itself.
//
//   base  #232136   overlay        #393552   iris  #c4a7e7
//   love  #eb6f92   highlight-med  #44415a   foam  #9ccfd8

layout {
    // Shown only until enso-wall has drawn, and behind "contain" wallpapers.
    background-color "#232136"            // base

    focus-ring {
        active-color   "#c4a7e7"          // iris
        inactive-color "#44415a"          // highlight-med
        urgent-color   "#eb6f92"          // love
    }

    border {
        active-color   "#c4a7e7"
        inactive-color "#44415a"
        urgent-color   "#eb6f92"
    }

    shadow {
        color "#00000066"
    }

    tab-indicator {
        active-color   "#c4a7e7"
        inactive-color "#44415a"
        urgent-color   "#eb6f92"
    }

    insert-hint {
        color "#c4a7e766"                 // iris, translucent
    }
}

overview {
    backdrop-color "#232136"              // base
}

recent-windows {
    highlight {
        active-color "#c4a7e7"
        urgent-color "#eb6f92"
        corner-radius 12
    }
}
